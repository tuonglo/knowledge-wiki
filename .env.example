# Copy to .env and adjust. Compose and local dev both read these.
POSTGRES_USER=kw
POSTGRES_PASSWORD=kw
POSTGRES_DB=kw
# Host ports; change if another project already uses them.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://kw:kw@localhost:5432/kw
REDIS_URL=redis://localhost:6379

API_PORT=4000
AI_PORT=8000
WEB_ORIGIN=http://localhost:3000

# The API's address AS THE BROWSER SEES IT. The web app proxies /api/* to the API, so
# everything is one origin (localhost:3000). OAuth callback URLs are built from it:
#   ${API_URL}/auth/github/callback and ${API_URL}/auth/google/callback
API_URL=http://localhost:3000/api

# OAuth apps — see README "OAuth setup". Never commit real values.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Access-token signing keys (RS256, base64-encoded PEM).
# Generate with: pnpm --filter @kw/api gen:keys   (appends them to .env)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
